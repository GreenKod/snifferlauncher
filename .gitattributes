# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure all source code, configs, and assets are checked out with LF
*.rs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Binary files
*.keystore binary
*.png binary
*.jpg binary
*.jpeg binary
*.bin binary
*.so binary
*.dll binary
*.dylib binary
