#!/usr/bin/env bash
# ==============================================================================
# SnifferLauncher Git Pre-Commit Hook (.githooks/pre-commit)
# ==============================================================================
# Automatically restores Cargo.toml from Local Dev mode (../snifferengine) to
# Git mode (https://github.com/GreenKod/snifferengine.git) and syncs Cargo.lock
# before creating a commit, then stages both files into the commit.
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

GIT_ENGINE='sniffer_engine = { git = "https://github.com/GreenKod/snifferengine.git" }'
LOCAL_ENGINE='sniffer_engine = { path = "../snifferengine/crates/sniffer_engine" }'

GIT_PATCH='android-activity = { git = "https://github.com/GreenKod/snifferengine.git" }'
LOCAL_PATCH='android-activity = { path = "../snifferengine/patches/android-activity" }'

NEED_LOCK_SYNC=0

if grep -qF "$LOCAL_ENGINE" Cargo.toml; then
    echo -e "\033[1;33m[pre-commit] Cargo.toml yerel DEV modunda bulundu; otomatik olarak GitHub moduna çevriliyor...\033[0m"
    sed -i "s|$LOCAL_ENGINE|$GIT_ENGINE|g" Cargo.toml
    sed -i "s|$LOCAL_PATCH|$GIT_PATCH|g" Cargo.toml
    NEED_LOCK_SYNC=1
fi

if ! grep -A 3 'name = "sniffer_engine"' Cargo.lock | grep -q 'source = "git+https://github.com/GreenKod/snifferengine.git#'; then
    NEED_LOCK_SYNC=1
fi

if [ "$NEED_LOCK_SYNC" -eq 1 ]; then
    echo -e "\033[1;34m[pre-commit] Cargo.lock GitHub snifferengine kaynağı ile senkronize ediliyor...\033[0m"
    cargo update -p sniffer_engine -p android-activity
    git add Cargo.toml Cargo.lock
    echo -e "\033[1;32m[pre-commit] ✔ Cargo.toml ve Cargo.lock güncellendi ve commite eklendi.\033[0m"
fi

